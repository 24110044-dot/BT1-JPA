# Copy to .env and set real values locally. Never commit .env.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
REMEMBER_ME_KEY=replace-with-a-long-random-secret
VIDEO_UPLOAD_DIR=uploads/videos
APP_MAX_VIDEO_FILE_SIZE=200MB
APP_MAX_REQUEST_SIZE=205MB
APP_MAX_VIDEO_FILE_SIZE_BYTES=209715200
